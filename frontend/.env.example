# Base URL of the Clerkstone API. Defaults to the same-origin `/api/v1` path
# (which the Nginx reverse proxy routes to the FastAPI backend). Override only
# when the API is served from a different origin (e.g. local dev against a
# separately-hosted backend, or a cross-origin deployment).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Optional demo JWT for local development against a running backend.
# Never commit a real token. In production the token is obtained via login.
# NEXT_PUBLIC_DEMO_TOKEN=
