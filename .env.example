# --- App ---
APP_ENV=development               # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000   # allow-list, never *
RATE_LIMIT_PER_MINUTE=120
MAX_BUNDLE_SIZE_MB=20
MAX_PAGE_SIZE=200

# --- Database ---
DATABASE_URL=postgresql+asyncpg://clerkstone:clerkstone@localhost:5432/clerkstone
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=5000

# --- Auth (JWT RS256) ---
JWT_ISSUER=https://clerkstone.local
JWT_AUDIENCE=clerkstone-api
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem    # never inline the key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# --- FHIR validator sidecar ---
VALIDATOR_BASE_URL=http://localhost:8080
VALIDATOR_TIMEOUT_SECONDS=20
UKCORE_PACKAGE_VERSION=hl7.fhir.uk.core.r4@2.4.0

# --- Terminology (DI seam: local | nhse | offline-stub) ---
TERMINOLOGY_BACKEND=local
TERMINOLOGY_LOCAL_DB_PATH=./data/terminology/subset.json
TERMINOLOGY_NHSE_BASE_URL=https://ontology.nhs.uk/production1/fhir
TERMINOLOGY_NHSE_API_KEY=
TERMINOLOGY_CACHE_TTL_SECONDS=86400
TERMINOLOGY_CIRCUIT_BREAKER_THRESHOLD=5

# --- Audit ---
AUDIT_HASH_SALT=change-me-in-production
AUDIT_VERIFY_ON_STARTUP=true

# --- Data classification (defence in depth) ---
DATA_CLASS=synthetic
